{
  // Run from static/: `npx -p typescript tsc` (once) or add `--watch` to
  // recompile on every save. No bundler — this just turns app.ts into
  // app.js sitting right next to it, which index.html already loads via
  // <script type="module" src="app.js">.
  "compilerOptions": {
    // Browser code, not Node — DOM gives you `document`, `fetch`, etc.
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    // ES module output to match <script type="module">. Irrelevant while
    // app.ts is a single file with no import/export, but free to have
    // right if it ever splits into more than one module.
    "module": "ES2020",
    "moduleResolution": "bundler",

    // No rootDir/outDir: leaving both unset is what actually compiles in
    // place (app.ts -> app.js, same folder). Setting outDir to "." looks
    // equivalent but isn't — it makes tsc auto-exclude this directory as
    // its own output folder, which excludes the very .ts files you meant
    // to include.

    // Catch mistakes at compile time instead of `undefined` showing up
    // silently in the rendered page — the same spirit as the backend's
    // "type-hint everything" convention, applied on this side of the wire.
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,

    // Don't emit app.js from a file that has type errors.
    "noEmitOnError": true,

    // Maps compiled app.js back to app.ts in DevTools, so breakpoints and
    // stack traces point at the source you actually wrote.
    "sourceMap": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
